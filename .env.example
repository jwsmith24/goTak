# Copy this file to .env and fill in your dev server's credentials.
# .env is gitignored - never commit real credentials.
GOTAK_SERVER=192.168.1.50
GOTAK_USERNAME=dev
GOTAK_PASSWORD=devpass
# Optional: path to a JSON scenario file (see scenarios/austin-capitol.json).
# Only used as a fallback when the interactive scenario menu isn't shown
# (e.g. no scenarios/ directory found); it does not skip that menu. Use
# the -scenario flag instead to run a scenario non-interactively.
GOTAK_SCENARIO=
